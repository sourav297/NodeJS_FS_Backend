                                    "zipCode": {
                                        "type": "string",
                                        "default": "445"
                                    },
                                    "email": {
                                        "type": "string",
                                        "default": "noton123@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "default": "noton123"
                                    }
                                }
                            }
                        }
